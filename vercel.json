{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/payment-call",
      "destination": "/api/payment-call.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!Practice/|assets/Practice/).*)",
      "destination": "/index.html"
    }
  ]
}
