{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "builds": [
    {
      "src": "dist/server.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "dist/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "dist/server.cjs"
    },
    {
      "source": "/((?!Practice/|assets/Practice/).*)",
      "destination": "/index.html"
    }
  ]
}
